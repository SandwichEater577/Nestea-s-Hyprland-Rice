[Unit]
Description=Rice QuickShell status bar
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=8

[Service]
Type=simple
ExecStart=/usr/bin/quickshell --path %h/.local/share/rice/source/src/quickshell/shell.qml
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
