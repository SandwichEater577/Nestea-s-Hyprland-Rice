[Unit]
Description=Rice QuickShell status bar
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=8

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=quickshell --path %h/.local/share/rice/source/src/quickshell/shell.qml
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
