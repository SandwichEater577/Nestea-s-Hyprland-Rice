#!/usr/bin/env python3
"""Read or set the size of the previous, play and next bar controls."""
import json
from pathlib import Path
import sys

path = Path.home() / '.config/rice/bar-controls.json'
try:
    data = json.loads(path.read_text())
    if not isinstance(data, dict):
        data = {}
except (OSError, ValueError):
    data = {}

if len(sys.argv) == 1:
    print(data.get('spotify_manage_button_size', 24))
elif len(sys.argv) == 2 and sys.argv[1].isdigit() and 16 <= int(sys.argv[1]) <= 26:
    data['spotify_manage_button_size'] = int(sys.argv[1])
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(data, indent=2) + '\n')
    temporary.replace(path)
else:
    print('usage: controll-size-of-spotify-manage-buttons.exec [16..26]', file=sys.stderr)
    sys.exit(2)
