#!/usr/bin/env python3
"""Workspace buttons and attention state from Hyprland's event socket."""
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import time


def query(name, fallback):
    try:
        result = subprocess.run(['hyprctl', '-j', name], capture_output=True,
                                text=True, timeout=2)
        return json.loads(result.stdout) if result.returncode == 0 else fallback
    except (OSError, ValueError, subprocess.SubprocessError):
        return fallback


def active():
    return int(query('activeworkspace', {}).get('id', 0))


def occupied():
    return {int(item['id']) for item in query('workspaces', []) if int(item.get('id', 0)) > 5}


def workspace_for(address):
    for client in query('clients', []):
        if client.get('address', '').removeprefix('0x').lower() == address.lower():
            return int(client.get('workspace', {}).get('id', 0))
    return 0


def extra_workspace(current, existing, attention):
    if current > 5:
        return current
    far_attention = [number for number in attention if number > 5]
    if far_attention:
        return far_attention[-1]
    return max(existing, default=0)


def stream(mode, number=0):
    previous = None
    urgents = {}  # window address -> workspace, cleared when that workspace is visited
    current = active()
    existing = occupied()
    extra_file = Path.home() / '.local/state/rice/workspace-extra'

    def emit():
        nonlocal previous
        attention = list(dict.fromkeys(urgents.values()))
        extra = extra_workspace(current, existing, attention)
        if mode == 'button':
            visible = number <= 5 or number in existing or number == current
            payload = {'text': str(number) if visible else '',
                       'class': 'active' if current == number else
                                'attention' if number in attention else 'inactive'}
        elif mode == 'extra':
            payload = {'text': str(extra) if extra else '',
                       'class': 'active' if current == extra and extra else
                                'attention' if extra in attention else 'inactive'}
            extra_file.parent.mkdir(parents=True, exist_ok=True)
            extra_file.write_text(str(extra) if extra else '')
        else:
            payload = {'active': current, 'extra': extra, 'attention': attention}
        if payload != previous:
            print(json.dumps(payload), flush=True)
            previous = payload

    emit()
    root = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/' + str(os.getuid())))
    signature = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')
    path = root / 'hypr' / signature / '.socket2.sock'
    while True:
        try:
            with socket.socket(socket.AF_UNIX) as connection:
                connection.connect(str(path))
                urgents.clear()
                current = active()
                existing = occupied()
                emit()
                with connection.makefile() as events:
                    for line in events:
                        kind, sep, data = line.strip().partition('>>')
                        if not sep:
                            continue
                        if kind in ('workspace', 'workspacev2'):
                            try:
                                current = int(data.split(',', 1)[0])
                            except ValueError:
                                current = active()
                            urgents = {address: ws for address, ws in urgents.items() if ws != current}
                            existing = occupied()
                        elif kind == 'urgent':
                            address = data.removeprefix('0x').lower()
                            target = workspace_for(address)
                            if target > 0 and target != current:
                                urgents[address] = target
                        elif kind == 'closewindow':
                            urgents.pop(data.removeprefix('0x').lower(), None)
                            existing = occupied()
                        elif kind in ('openwindow', 'movewindow', 'movewindowv2',
                                      'createworkspace', 'destroyworkspace'):
                            existing = occupied()
                            if kind.startswith('movewindow'):
                                address = data.split(',', 1)[0].removeprefix('0x').lower()
                                if address in urgents:
                                    urgents[address] = workspace_for(address)
                        else:
                            continue
                        emit()
        except (OSError, BrokenPipeError):
            current = active()
            existing = occupied()
            emit()
            time.sleep(1)


def focus(number):
    if number < 1:
        raise ValueError('workspace number must be positive')
    raise SystemExit(subprocess.run(['hyprctl', 'dispatch',
                     f'hl.dsp.focus({{workspace={number}}})']).returncode)


def main():
    args = sys.argv[1:]
    if args == ['--stream']:
        stream('stream')
    elif args == ['--watch-extra']:
        stream('extra')
    elif args == ['--go-extra']:
        path = Path.home() / '.local/state/rice/workspace-extra'
        try:
            number = int(path.read_text().strip())
        except (OSError, ValueError):
            number = 0
        if number > 5:
            focus(number)
    elif len(args) == 2 and args[0] == '--watch' and args[1].isdigit():
        stream('button', int(args[1]))
    elif len(args) == 1 and args[0].isdigit():
        focus(int(args[0]))
    else:
        raise ValueError('usage: rice-workspace [--stream|--watch-extra|--go-extra|--watch N|N]')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, BrokenPipeError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
