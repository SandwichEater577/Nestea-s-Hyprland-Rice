#!/usr/bin/env python3
"""Workspace buttons and attention state from Hyprland's event socket."""
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import time


def query(name, fallback):
    try:
        result = subprocess.run(['hyprctl', '-j', name], capture_output=True,
                                text=True, timeout=2)
        return json.loads(result.stdout) if result.returncode == 0 else fallback
    except (OSError, ValueError, subprocess.SubprocessError):
        return fallback


def active():
    return int(query('activeworkspace', {}).get('id', 0))


def occupied():
    return {int(client.get('workspace', {}).get('id', 0))
            for client in query('clients', [])
            if client.get('mapped', True) and int(client.get('workspace', {}).get('id', 0)) > 5}


def workspace_for(address):
    for client in query('clients', []):
        if client.get('address', '').removeprefix('0x').lower() == address.lower():
            return int(client.get('workspace', {}).get('id', 0))
    return 0


def visible_workspaces(current, existing):
    return sorted(set(range(1, 6)) | existing | ({current} if current > 0 else set()))


def stream():
    previous = None
    urgents = {}  # window address -> workspace, cleared when that workspace is visited
    current = active()
    existing = occupied()
    def emit():
        nonlocal previous
        attention = list(dict.fromkeys(urgents.values()))
        visible = visible_workspaces(current, existing)
        payload = {'active': current, 'visible': visible, 'attention': attention}
        if payload != previous:
            print(json.dumps(payload), flush=True)
            previous = payload

    emit()
    root = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/' + str(os.getuid())))
    signature = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')
    path = root / 'hypr' / signature / '.socket2.sock'
    while True:
        try:
            with socket.socket(socket.AF_UNIX) as connection:
                connection.connect(str(path))
                urgents.clear()
                current = active()
                existing = occupied()
                emit()
                with connection.makefile() as events:
                    for line in events:
                        kind, sep, data = line.strip().partition('>>')
                        if not sep:
                            continue
                        if kind in ('workspace', 'workspacev2'):
                            try:
                                current = int(data.split(',', 1)[0])
                            except ValueError:
                                current = active()
                            urgents = {address: ws for address, ws in urgents.items() if ws != current}
                            existing = occupied()
                        elif kind == 'urgent':
                            address = data.removeprefix('0x').lower()
                            target = workspace_for(address)
                            if target > 0 and target != current:
                                urgents[address] = target
                        elif kind == 'closewindow':
                            urgents.pop(data.removeprefix('0x').lower(), None)
                            existing = occupied()
                        elif kind in ('openwindow', 'movewindow', 'movewindowv2',
                                      'createworkspace', 'destroyworkspace'):
                            existing = occupied()
                            if kind.startswith('movewindow'):
                                address = data.split(',', 1)[0].removeprefix('0x').lower()
                                if address in urgents:
                                    urgents[address] = workspace_for(address)
                        else:
                            continue
                        emit()
        except (OSError, BrokenPipeError):
            current = active()
            existing = occupied()
            emit()
            time.sleep(1)


def focus(number):
    if number < 1:
        raise ValueError('workspace number must be positive')
    raise SystemExit(subprocess.run(['hyprctl', 'dispatch',
                     f'hl.dsp.focus({{workspace={number}}})']).returncode)


def main():
    args = sys.argv[1:]
    if args == ['--stream']:
        stream()
    elif len(args) == 1 and args[0].isdigit():
        focus(int(args[0]))
    else:
        raise ValueError('usage: rice-workspace [--stream|N]')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, BrokenPipeError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
