#!/usr/bin/env python3
"""Keep one bar visible while preparing and switching renderer processes."""
import fcntl
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time

HOME = Path.home()
STATE = HOME / '.local/state/rice'
CHOICE = STATE / 'ui-backend'
STARTS = STATE / 'ui-backend-starts.json'
SOCKET = STATE / 'ui-backend.sock'
WAYBAR_CONFIG = HOME / '.config/waybar/config.jsonc'
VALID = ('lua', 'quickshell', 'cpp')
NAMESPACE = {'lua': 'waybar', 'quickshell': 'quickshell', 'cpp': 'gtk-layer-shell'}


def selected():
    try:
        value = CHOICE.read_text().strip()
        return value if value in VALID else 'lua'
    except OSError:
        return 'lua'


def command(choice):
    if choice == 'lua':
        return [str(HOME / '.local/bin/start-waybar')]
    if choice == 'quickshell':
        return ['quickshell', '--path', str(HOME / '.local/share/rice/source/src/quickshell/shell.qml')]
    return [str(HOME / '.local/lib/rice/rice-bar')]


def ready(choice, build=False):
    if choice == 'cpp' and build:
        subprocess.run([str(HOME / '.local/bin/build-rice-bar')], check=True, timeout=90)
    path = command(choice)[0]
    if '/' in path and not Path(path).is_file():
        raise RuntimeError(f'{path} is missing; run the Installer')
    if '/' not in path and not shutil_which(path):
        raise RuntimeError(f'{path} is not installed')


def shutil_which(name):
    from shutil import which
    return which(name)


def save(choice):
    STATE.mkdir(parents=True, exist_ok=True)
    temp = CHOICE.with_name(f'{CHOICE.name}.{os.getpid()}.tmp')
    temp.write_text(choice + '\n')
    temp.replace(CHOICE)


def record_start(choice):
    """Select Waybar on the fourth start in 30 seconds of an optional bar."""
    STATE.mkdir(parents=True, exist_ok=True)
    now = time.time()
    try:
        data = json.loads(STARTS.read_text())
        times = data['times'] if data['choice'] == choice else []
        times = [float(t) for t in times if 0 <= now - float(t) < 30]
    except (OSError, ValueError, KeyError, TypeError):
        times = []
    times.append(now)
    if choice != 'lua' and len(times) >= 4:
        save('lua')
        choice, times = 'lua', [now]
        print('Bar: repeated crashes; restored Lua / Waybar', file=sys.stderr, flush=True)
    temp = STARTS.with_name(f'{STARTS.name}.{os.getpid()}.tmp')
    temp.write_text(json.dumps({'choice': choice, 'times': times}))
    temp.replace(STARTS)
    return choice


def layer_visible(choice, pid):
    result = subprocess.run(['hyprctl', '-j', 'layers'], capture_output=True, text=True, timeout=2)
    try:
        for monitor in json.loads(result.stdout).values():
            for level in monitor.get('levels', {}).values():
                if any(layer.get('pid') == pid and layer.get('namespace') == NAMESPACE[choice] for layer in level):
                    return True
    except (ValueError, TypeError, AttributeError):
        pass
    return False


def wait_visible(choice, process, seconds=8):
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        if process.poll() is not None:
            return False
        if layer_visible(choice, process.pid):
            time.sleep(.15)
            return process.poll() is None and layer_visible(choice, process.pid)
        time.sleep(.15)
    return False


def stop(process):
    if process is not None and process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
    time.sleep(.05)
    # Waybar may terminate its audio module before the module can reap pactl.
    # Only remove orphan event readers left inside this service's cgroup.
    for entry in Path('/proc').iterdir():
        if not entry.name.isdigit():
            continue
        try:
            status = (entry / 'status').read_text()
            parent = int(next(line.split()[1] for line in status.splitlines() if line.startswith('PPid:')))
            group = (entry / 'cgroup').read_text().strip()
            args = (entry / 'cmdline').read_bytes().split(b'\0')
            name = Path(args[0].decode()).name
        except (OSError, StopIteration, ValueError, IndexError, UnicodeError):
            continue
        if parent not in (1, os.getppid()) or not group.endswith('/rice-bar.service'):
            continue
        if (name == 'pactl' and args[1:2] == [b'subscribe']) or (
                name == 'dbus-monitor' and b'--session' in args and
                any(b'org.mpris.MediaPlayer2' in arg for arg in args)):
            try:
                os.kill(int(entry.name), signal.SIGTERM)
            except ProcessLookupError:
                pass


def start(choice):
    ready(choice)
    process = subprocess.Popen(command(choice))
    if not wait_visible(choice, process):
        stop(process)
        raise RuntimeError(f'{choice} did not create a visible bar')
    return process


def config_stamp():
    try:
        stat = WAYBAR_CONFIG.stat()
        return stat.st_mtime_ns, stat.st_size
    except OSError:
        return None


def serve():
    STATE.mkdir(parents=True, exist_ok=True)
    if SOCKET.exists():
        SOCKET.unlink()
    server = socket.socket(socket.AF_UNIX)
    server.bind(str(SOCKET))
    SOCKET.chmod(0o600)
    server.listen(1)
    server.settimeout(.5)
    bar = None
    choice = record_start(selected())
    last_config = config_stamp()

    def shutdown(*_):
        stop(bar)
        server.close()
        SOCKET.unlink(missing_ok=True)
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    try:
        try:
            bar = start(choice)
        except (OSError, RuntimeError, subprocess.SubprocessError):
            choice = 'lua'
            save(choice)
            bar = start(choice)
        while True:
            if bar.poll() is not None:
                choice = record_start(choice)
                try:
                    bar = start(choice)
                except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                    print(f'Bar start failed: {error}', file=sys.stderr, flush=True)
                    choice = 'lua'
                    save(choice)
                    time.sleep(1)
                    bar = start(choice)
            changed = config_stamp()
            if choice == 'lua' and changed != last_config and changed is not None:
                last_config = changed
                try:
                    replacement = start('lua')
                    previous = bar
                    bar = replacement
                    stop(previous)
                except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                    print(f'Waybar config reload kept previous bar: {error}', file=sys.stderr, flush=True)
            else:
                last_config = changed
            try:
                connection, _ = server.accept()
            except socket.timeout:
                continue
            with connection:
                connection.settimeout(15)
                try:
                    requested = connection.recv(64).decode().strip()
                    if requested not in (*VALID, 'reload'):
                        raise RuntimeError('unknown bar engine')
                    target = choice if requested == 'reload' else requested
                    if requested == 'reload' or target != choice:
                        new_bar = start(target)
                        old_bar = bar
                        bar, choice = new_bar, target
                        save(choice)
                        STARTS.unlink(missing_ok=True)
                        record_start(choice)
                        stop(old_bar)
                        last_config = config_stamp()
                    connection.sendall(f'OK {choice}\n'.encode())
                except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                    try:
                        connection.sendall(f'ERROR {error}\n'.encode())
                    except OSError:
                        pass
    finally:
        stop(bar)
        server.close()
        SOCKET.unlink(missing_ok=True)


def switch(choice):
    ready(selected() if choice == 'reload' else choice, build=True)
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'ui-backend.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not SOCKET.exists():
            subprocess.run(['systemctl', '--user', 'start', 'rice-bar.service'], check=True, timeout=12)
        with socket.socket(socket.AF_UNIX) as connection:
            connection.settimeout(15)
            connection.connect(str(SOCKET))
            connection.sendall((choice + '\n').encode())
            response = connection.recv(512).decode().strip()
        if not response.startswith('OK '):
            raise RuntimeError(response or 'supervisor did not respond')
        print(response[3:])


def main():
    if len(sys.argv) != 2:
        raise RuntimeError('usage: ui-backend get|run|reload|lua|quickshell|cpp')
    action = sys.argv[1]
    if action == 'get':
        print(selected())
    elif action == 'run':
        serve()
    elif action in (*VALID, 'reload'):
        switch(action)
    else:
        raise RuntimeError(f'unknown action: {action}')


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError, socket.timeout) as error:
        print(f'Bar backend: {error}', file=sys.stderr)
        sys.exit(1)
