#!/usr/bin/env python3
"""Refresh Waybar media widgets from MPRIS property and player events."""
import subprocess
import time

MATCHES = [
    "type='signal',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged',path='/org/mpris/MediaPlayer2'",
    "type='signal',interface='org.freedesktop.DBus',member='NameOwnerChanged',arg0namespace='org.mpris.MediaPlayer2'",
]

while True:
    try:
        with subprocess.Popen(['dbus-monitor', '--session', *MATCHES],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              text=True, bufsize=1) as process:
            for line in process.stdout:
                if 'member=PropertiesChanged' in line or 'member=NameOwnerChanged' in line:
                    subprocess.run(['pkill', '-RTMIN+10', '-x', 'waybar'],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass
    time.sleep(2)
