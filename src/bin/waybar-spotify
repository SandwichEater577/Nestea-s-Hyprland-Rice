#!/usr/bin/env python3
"""Waybar media widgets from the selected MPRIS player."""
import html
import json
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path.home() / '.local/lib/rice'))
import mpris


def notify():
    kick = Path.home() / '.local/state/rice/status-kick'
    kick.parent.mkdir(parents=True, exist_ok=True)
    kick.touch(exist_ok=True)
    subprocess.run(['pkill', '-RTMIN+10', '-x', 'waybar'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def show(option):
    fields = (('loop',) if option in ('--repeat', '--cycle-repeat') else
              ('shuffle',) if option in ('--shuffle', '--toggle-shuffle') else
              ('metadata',) if option == '--cover' else ())
    state = mpris.get_state(fields)
    if option == '--cycle-repeat':
        if state:
            mode = state.get('LoopStatus', 'None')
            target = {'None': 'Playlist', 'Playlist': 'Track', 'Track': 'None'}.get(mode)
            if target:
                mpris.set_property(state['_name'], 'LoopStatus', target)
                notify()
        return
    if option == '--toggle-shuffle':
        if state:
            mpris.set_property(state['_name'], 'Shuffle', state.get('Shuffle') != 'On')
            notify()
        return
    if option == '--cover':
        try:
            path, title = mpris.cover(state)
            print(path + '\n' + html.escape(title), flush=True)
        except (OSError, ValueError):
            print('', flush=True)
        return
    if option in ('--prev', '--next'):
        widget = {'text': ('󰒮' if option == '--prev' else '󰒭') if state else ''}
    else:
        widget = (mpris.shuffle_widget(state) if option == '--shuffle' else
                  mpris.repeat_widget(state) if option == '--repeat' else
                  mpris.status_widget(state))
    print(json.dumps(widget, ensure_ascii=False), flush=True)


def main():
    show(sys.argv[1] if len(sys.argv) > 1 else '')


if __name__ == '__main__':
    main()
