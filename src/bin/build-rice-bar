#!/usr/bin/env bash
set -euo pipefail
source_dir="$HOME/.local/share/rice/source/src/native"
target_dir="$HOME/.local/lib/rice"
mkdir -p "$target_dir"
sources=("$source_dir/rice-bar.cpp")
if [[ $(uname -m) == x86_64 ]]; then sources+=("$source_dir/luma.S"); fi
g++ -std=c++17 -O2 -Wall -Wextra "${sources[@]}" -o "$target_dir/rice-bar.new" \
    $(pkg-config --cflags --libs gtk+-3.0 gtk-layer-shell-0 json-glib-1.0)
chmod 755 "$target_dir/rice-bar.new"
mv -f "$target_dir/rice-bar.new" "$target_dir/rice-bar"
