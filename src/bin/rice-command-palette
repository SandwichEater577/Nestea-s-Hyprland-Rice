#!/usr/bin/env python3
"""Search existing rice actions by plain names, without shell evaluation."""
from pathlib import Path
import shutil
import subprocess
import sys


BIN = Path.home() / '.local/bin'


def actions():
    rows = [
        ('Quick settings · brightness, power and rice', [BIN / 'rice-show-settings']),
        ('Sound · output and volume', [BIN / 'desktop-panel', 'audio']),
        ('Microphone · input and mute', [BIN / 'desktop-panel', 'audio']),
        ('Wi-Fi · network connections', [BIN / 'desktop-panel', 'network']),
        ('Bluetooth · devices', [BIN / 'desktop-panel', 'bluetooth']),
        ('Displays · layout and scale', [BIN / 'desktop-panel', 'display']),
        ('Media · players and controls', [BIN / 'desktop-panel', 'media']),
        ('Clipboard history', [BIN / 'clipboard-menu']),
        ('Screenshot · select region', [BIN / 'screenshot', 'region']),
        ('Screenshot · full screen', [BIN / 'screenshot', 'full']),
        ('Wallpaper · next image', [BIN / 'change-wallpaper']),
        ('Update history', [BIN / 'desktop-panel', 'updates']),
        ('Lock screen', [BIN / 'lock-screen']),
        ('Power menu · suspend, restart, shut down', [BIN / 'desktop-menu', 'power']),
    ]
    if shutil.which('code'):
        rows.insert(7, ('VS Code · projects and folders', [BIN / 'vscode-menu']))
    if shutil.which('kitty'):
        rows.insert(7, ('Terminal', ['kitty']))
    if shutil.which('thunar'):
        rows.insert(8, ('Files', ['thunar']))
    if shutil.which('btop') and shutil.which('kitty'):
        rows.append(('System monitor · CPU, memory and processes', ['kitty', 'btop']))
    return rows


def main():
    rows = actions()
    if sys.argv[1:] == ['--list']:
        print('\n'.join(title for title, _ in rows))
        return 0
    result = subprocess.run(
        ['rofi', '-dmenu', '-i', '-no-custom', '-format', 'i', '-p', 'Actions',
         '-mesg', 'RICE  /  Search desktop actions'],
        input='\n'.join(title for title, _ in rows) + '\n',
        text=True, capture_output=True, check=False)
    if result.returncode != 0:
        return 0
    try:
        index = int(result.stdout.strip())
    except ValueError:
        return 0
    if not 0 <= index < len(rows):
        return 0
    subprocess.Popen([str(arg) for arg in rows[index][1]],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
