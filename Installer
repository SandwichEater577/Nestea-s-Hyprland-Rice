#!/usr/bin/env bash
# Interactive front end; installation work lives in src/installer/install.sh.
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
core=$repo/src/installer/install.sh
[[ -t 0 && -t 1 ]] && interactive_tty=true || interactive_tty=false
if [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; then
    violet=$'\033[38;2;179;142;255m' cyan=$'\033[38;2;104;218;230m' green=$'\033[38;2;162;221;176m'
    dim=$'\033[38;2;136;142;153m' white=$'\033[1;38;2;245;247;250m' reset=$'\033[0m'
else
    violet= cyan= green= dim= white= reset=
fi

usage() {
    cat <<'EOF'
Nestea's Rice for Hyprland

  ./Installer             interactive setup
  ./Installer --check     show readiness and missing programs
  ./Installer --install   install or refresh without the menu
  ./Installer --deps      review Arch dependencies
  ./Installer --uninstall ask for feedback, then restore the previous desktop

Clock format can also be changed in the live settings menu.
EOF
}

check() {
    local programs=(Hyprland quickshell lua python3 git nmcli bluetoothctl wpctl playerctl rofi kitty thunar hyprpaper magick pactl dbus-monitor jq g++ pkg-config brightnessctl notify-send zenity wl-paste cliphist hypridle hyprlock xdg-open fastfetch btop)
    local missing=() item net bt audio
    for item in "${programs[@]}"; do command -v "$item" >/dev/null || missing+=("$item"); done
    if command -v pkg-config >/dev/null && ! pkg-config --exists Qt6Core Qt6DBus Qt6Concurrent; then
        missing+=("Qt6Core/Qt6DBus/Qt6Concurrent development files")
    fi
    if ! python3 -c 'import gi; gi.require_version("Gtk", "3.0"); gi.require_version("GtkLayerShell", "0.1"); from gi.repository import Gtk, GtkLayerShell' >/dev/null 2>&1; then
        missing+=("Python GTK 3 and GtkLayerShell bindings")
    fi
    if command -v pacman >/dev/null && ! pacman -Qq tlp-pd >/dev/null 2>&1 &&
       ! pacman -Qq power-profiles-daemon >/dev/null 2>&1 &&
       ! pacman -Qq tuned-ppd >/dev/null 2>&1; then
        missing+=("power profile D-Bus provider")
    fi
    if [[ ${RICE_DESKTOP_SPOTIFY:-no} == yes ]] && ! command -v spotify-launcher >/dev/null; then
        missing+=("spotify-launcher")
    fi
    net=$(systemctl is-active NetworkManager 2>/dev/null || true)
    bt=$(systemctl is-active bluetooth 2>/dev/null || true)
    audio=$(systemctl --user is-active pipewire 2>/dev/null || true)
    printf 'System      %s\n' "$(. /etc/os-release; printf '%s' "$PRETTY_NAME")"
    printf 'Hyprland    %s\n' "$(command -v Hyprland || printf missing)"
    printf 'QuickShell  %s\n' "$(command -v quickshell || printf missing)"
    printf 'Network     %s\n' "${net:-inactive}"
    printf 'Bluetooth   %s\n' "${bt:-inactive}"
    printf 'Audio       %s\n' "${audio:-inactive}"
    printf 'Session     %s\n' "${WAYLAND_DISPLAY:-start-Hyprland-to-preview-the-bar}"
    printf 'Missing     %s\n' "${missing[*]:-none}"
    (("${#missing[@]}" == 0))
}

deps() {
    command -v pacman >/dev/null || { echo 'Automatic dependency setup is for Arch and EndeavourOS.' >&2; return 1; }
    local packages=(hyprland quickshell gtk3 gtk-layer-shell imagemagick lua python python-gobject
                    gcc pkgconf qt6-base qt6-declarative git
                    networkmanager bluez bluez-utils playerctl brightnessctl rofi kitty thunar hyprpaper
                    mako libnotify pipewire-pulse jq zenity wl-clipboard cliphist hypridle hyprlock
                    hyprpolkitagent xdg-utils fastfetch btop gamemode)
    if [[ ${RICE_DESKTOP_SPOTIFY:-no} == yes ]]; then packages+=(spotify-launcher); fi
    if ! pacman -Qq tlp-pd >/dev/null 2>&1 && ! pacman -Qq power-profiles-daemon >/dev/null 2>&1 &&
       ! pacman -Qq tuned-ppd >/dev/null 2>&1; then
        packages+=(power-profiles-daemon)
    fi
    printf 'Arch packages: %s\n' "${packages[*]}"
    if [[ ${1:-} == --dry-run ]]; then
        printf 'Preview only: no packages or services will be changed.\n'
        return
    fi
    local answer
    if [[ ${1:-} != --yes ]]; then
        read -r -p 'Install missing packages with pacman? [y/N] ' answer
        [[ $answer == [yY] ]] || return 0
    fi
    sudo pacman -S --needed "${packages[@]}"
    if pacman -Qq power-profiles-daemon >/dev/null 2>&1; then
        sudo systemctl enable --now power-profiles-daemon.service
    fi
    if ! systemctl is-active --quiet NetworkManager || ! systemctl is-active --quiet bluetooth; then
        read -r -p 'Enable NetworkManager and Bluetooth now? [y/N] ' answer
        [[ $answer != [yY] ]] || sudo systemctl enable --now NetworkManager bluetooth
    fi
}

note() { printf '%s│%s  %s\n' "$dim" "$reset" "$*"; }
ok() { printf '%s◆%s  %s\n%s│%s\n' "$green" "$reset" "$*" "$dim" "$reset"; }
warn() { printf '%s■%s  %s\n%s│%s\n' "$violet" "$reset" "$*" "$dim" "$reset"; }
restore_cursor() { printf '\033[?25h' >&2; }
pause() { local _; printf '%s│%s  Press Enter to continue ' "$dim" "$reset"; IFS= read -r _ </dev/tty; printf '\n'; }

# Read options as key/label pairs. Redraw one compact prompt in place.
choose() {
    local question=$1 hint=$2 selected=$3 key seq n i choice='' label='' first=true
    shift 3
    local keys=() labels=()
    while (($#)); do keys+=("$1"); labels+=("$2"); shift 2; done
    n=${#keys[@]}
    printf '\033[?25l' >&2
    while :; do
        [[ $first == true ]] || printf '\033[%dA' "$((n+3))" >&2
        printf '\033[2K\r%s◇%s  %s%s%s\n' "$violet" "$reset" "$white" "$question" "$reset" >&2
        printf '\033[2K\r%s│%s  %s\n' "$dim" "$reset" "$hint" >&2
        for ((i=0;i<n;i++)); do
            if ((i==selected)); then
                printf '\033[2K\r%s│%s  %s❯%s %s%s%s\n' "$dim" "$reset" "$cyan" "$reset" "$white" "${labels[i]}" "$reset" >&2
            else
                printf '\033[2K\r%s│%s    %s%s%s\n' "$dim" "$reset" "$dim" "${labels[i]}" "$reset" >&2
            fi
        done
        printf '\033[2K\r%s└%s  %s↑ ↓ move  ·  enter select  ·  esc back%s\n' "$dim" "$reset" "$dim" "$reset" >&2
        first=false
        IFS= read -rsn1 key </dev/tty || { restore_cursor; return 1; }
        case $key in
            '') choice=${keys[selected]}; label=${labels[selected]}; break ;;
            $'\033')
                seq=''; IFS= read -rsn2 -t 0.08 seq </dev/tty || true
                case $seq in '[A') selected=$(((selected+n-1)%n));; '[B') selected=$(((selected+1)%n));; *) break;; esac ;;
            k|K) selected=$(((selected+n-1)%n)) ;;
            j|J) selected=$(((selected+1)%n)) ;;
            [1-9]) if ((key<=n)); then selected=$((key-1)); fi ;;
        esac
    done
    printf '\033[%dA' "$((n+3))" >&2
    for ((i=0;i<n+3;i++)); do printf '\033[2K\r\n' >&2; done
    printf '\033[%dA\033[?25h' "$((n+3))" >&2
    if [[ -n $choice ]]; then
        printf '%s◆%s  %s%s%s  %s›%s  %s\n%s│%s\n' "$green" "$reset" "$white" "$question" "$reset" "$dim" "$reset" "$label" "$dim" "$reset" >&2
        printf '%s\n' "$choice"
    else
        printf '%s└%s  Back\n' "$dim" "$reset" >&2
        return 1
    fi
}

spin() {
    local pid=$1 label=$2 i=0
    local frames=('● ○ ○ ○ ○ ○' '○ ● ○ ○ ○ ○' '○ ○ ● ○ ○ ○' '○ ○ ○ ● ○ ○' '○ ○ ○ ○ ● ○' '○ ○ ○ ○ ○ ●')
    printf '\033[?25l'
    while kill -0 "$pid" 2>/dev/null; do
        printf '\r\033[2K%s│%s  %s%s%s  %s' "$dim" "$reset" "$violet" "${frames[i%6]}" "$reset" "$label"
        sleep 0.11
        ((i+=1))
    done
    printf '\r\033[2K\033[?25h'
}

run_core() {
    local log pid status=0
    if [[ -n ${WAYLAND_DISPLAY:-} ]] && python3 -c 'import gi; gi.require_version("Gtk", "3.0"); gi.require_version("GtkLayerShell", "0.1"); from gi.repository import Gtk, GtkLayerShell' >/dev/null 2>&1; then
        python3 "$repo/src/bin/rice-install-progress" "$core" || status=$?
        if ((status)); then warn "Install stopped (exit $status)"; return "$status"; fi
        ok 'Rice installed and services refreshed'
        return 0
    fi
    log=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/rice-installer.XXXXXX")
    "$core" >"$log" 2>&1 & pid=$!
    spin "$pid" 'Installing rice'
    wait "$pid" || status=$?
    if ((status)); then warn "Install stopped (exit $status)"; cat "$log"
    else ok 'Rice installed and services refreshed'; fi
    unlink "$log"
    return "$status"
}

interactive() {
    [[ $interactive_tty == true ]] || { echo 'Interactive setup needs a terminal. Use --check, --install or --help.' >&2; return 2; }
    trap restore_cursor EXIT
    local clock desktop browser scale wifi bt packages answer current
    printf '\n%s┌──────────────────────────────────────────────────────┐%s\n' "$violet" "$reset"
    printf '%s│%s  %sNestea’s Rice for Hyprland%s   %s/ setup%s                %s│%s\n' "$violet" "$reset" "$white" "$reset" "$dim" "$reset" "$violet" "$reset"
    printf '%s└──────────────────────────────────────────────────────┘%s\n' "$violet" "$reset"
    note 'Answer each question, review the plan, then choose whether to install.'
    note ''

    current=24h
    if [[ -f $HOME/.config/rice/settings.json ]] && grep -Eq '"time_format"[[:space:]]*:[[:space:]]*"12h"' "$HOME/.config/rice/settings.json"; then current=12h; fi
    clock=$(choose '01 / 07  What should your clock format be?' "Current: $current · change it later from the live settings menu." \
        "$([[ $current == 12h ]] && printf 1 || printf 0)" \
        24h '24-hour time   [21:30:45]' 12h '12-hour time   [09:30:45 PM]') || return 0

    current=true
    if [[ -f $HOME/.config/rice/Media-Options.json ]] && grep -Eq '"desktop_spotify"[[:space:]]*:[[:space:]]*false' "$HOME/.config/rice/Media-Options.json"; then current=false; fi
    desktop=$(choose '02 / 07  Show desktop Spotify controls?' 'Cover, playback, shuffle and repeat appear when Spotify runs.' \
        "$([[ $current == true ]] && printf 0 || printf 1)" yes 'Yes, enable desktop Spotify' no 'No, keep it hidden') || return 0

    current=false
    if [[ -f $HOME/.config/rice/Media-Options.json ]] && grep -Eq '"browser_media"[[:space:]]*:[[:space:]]*true' "$HOME/.config/rice/Media-Options.json"; then current=true; fi
    browser=$(choose '03 / 07  Include browser music players?' 'Spotify Web, SoundCloud, YouTube Music and other MPRIS players.' \
        "$([[ $current == true ]] && printf 0 || printf 1)" yes 'Yes, include browser players' no 'No, desktop players only') || return 0

    current=$(cat "$HOME/.config/rice/display-device.tsv" 2>/dev/null || printf 'auto\t1.0')
    scale=$(choose '04 / 07  How large should the desktop look?' "Current: $current · keep uses the detected monitor setting." \
        0 keep 'Keep current scale' 1.0 '100%  [compact]' 1.25 '125%  [balanced]' 1.5 '150%  [larger]') || return 0

    wifi=$(choose '05 / 07  Set up Wi-Fi after installing?' 'NetworkManager stores remembered networks and passwords.' \
        0 later 'Later, use the live network menu' now 'Yes, open NetworkManager') || return 0

    bt=$(choose '06 / 07  Pair Bluetooth devices after installing?' 'BlueZ stores pairing keys; the live bar also has a device menu.' \
        0 later 'Later, use the live Bluetooth menu' now 'Yes, open Bluetooth tools') || return 0

    packages=$(choose '07 / 07  Install Arch dependencies?' 'Required programs must be present before the rice can be installed.' \
        0 yes 'Yes, install required dependencies' no 'No, use installed packages') || return 0

    note 'Your setup'
    note "Clock          $clock"
    note "Spotify        $desktop"
    note "Browser media  $browser"
    note "Display scale  $scale"
    note "Wi-Fi          $wifi"
    note "Bluetooth      $bt"
    note "Arch packages  $packages"
    note ''
    if [[ $packages == yes ]]; then RICE_DESKTOP_SPOTIFY="$desktop" deps --dry-run; note ''; fi

    answer=$(choose 'Ready to install Nestea’s Rice?' 'Packages (if selected), source files, services, then your preferences.' \
        0 yes 'Install with these choices' no 'Cancel without changing anything') || return 0
    if [[ $answer != yes ]]; then ok 'Cancelled · no changes made'; return; fi
    [[ $packages != yes ]] || RICE_DESKTOP_SPOTIFY="$desktop" deps --yes
    if ! RICE_DESKTOP_SPOTIFY="$desktop" check; then
        warn 'Required dependencies are missing. Re-run setup and choose Arch dependencies.'
        return 1
    fi
    export RICE_CLOCK="$clock" RICE_DESKTOP_SPOTIFY="$desktop" RICE_BROWSER_MEDIA="$browser" RICE_SCALE="$scale"
    if ! run_core; then return 1; fi
    [[ $wifi != now ]] || nmtui
    [[ $bt != now ]] || bluetoothctl
    printf '%s└%s  Setup complete · enjoy your rice.\n' "$violet" "$reset"
}

uninstall() {
    [[ $interactive_tty == true ]] || {
        echo 'Uninstall needs an interactive terminal so you can review the restore.' >&2
        return 2
    }
    [[ -f $HOME/.local/state/rice/pre-install/manifest ]] || {
        warn 'No pre-install snapshot exists; there is no safe automatic restore for this older installation.'
        return 1
    }
    local reason improvement answer feedback
    reason=$(choose 'Why are you uninstalling?' 'This stays on this PC unless you choose to share it.' \
        0 broken 'Something did not work' slow 'Performance was poor' look 'The design was not for me' other 'Another reason') || return 0
    printf 'What should improve? (optional): ' >&2
    IFS= read -r improvement </dev/tty || improvement=''
    answer=$(choose 'Restore your previous desktop?' 'Stops rice services and restores files saved before the first install.' \
        1 no 'Keep the rice' yes 'Uninstall and restore') || return 0
    [[ $answer == yes ]] || return 0
    feedback="$HOME/.local/state/rice/uninstall-feedback.txt"
    mkdir -p "$(dirname "$feedback")"
    printf 'Reason: %s\nImprove: %s\n' "$reason" "$improvement" > "$feedback"
    chmod 600 "$feedback"
    "$repo/src/installer/uninstall.sh"
    ok "Feedback saved locally at $feedback"
}
case ${1:-} in
    --help|-h) usage ;;
    --check) check ;;
    --install) check && "$core" ;;
    --deps) deps ;;
    --uninstall) uninstall ;;
    '') interactive ;;
    *) usage >&2; exit 2 ;;
esac
