!apply.lua
!manifest.lua
!hyprland.lua
!session.lua
!fastfetch.lua
!kitty.lua
!mako.lua
!cava.lua
!hypridle.lua
!hyprlock.lua
!hyprpaper.lua
!rofi.lua
!waybar.lua
!waybar-style.lua
!waybar-tooltip.lua
!data/
data/*
!data/README.md
!data/edit.py
!local/
local/*
!local/bin/
local/bin/*
!local/bin/change-wallpaper
!local/bin/clipboard-menu
!local/bin/control-menu
!local/bin/desktop-menu
!local/bin/desktop-panel
!local/bin/desktop-window
!local/bin/lock-screen
!local/bin/power-menu
!local/bin/screenshot
!local/bin/start-waybar
!local/bin/vscode-menu
!local/bin/waybar-spotify
!local/lib/
local/lib/*
!local/lib/rice/
local/lib/rice/*
!local/lib/rice/audio_watch.py
!local/lib/rice/bluetooth_pair.py
!local/lib/rice/desktop.py
!local/lib/rice/hotspot.py
!local/lib/rice/panels.css
!local/lib/rice/panels.py
!local/lib/rice/private_data.py
!local/lib/waybar/
local/lib/waybar/*
!local/lib/waybar/tooltip-delay.c
!native/
native/*
!native/hyprland.conf
!systemd/
systemd/*
!systemd/rice-hotspot.service
!power/
power/*
!power/10-laptop.conf

# Explicitly protect personal data if the allowlist is expanded later.
**/.env*
**/*password*
**/*secret*
**/*credential*
**/*token*
**/*private*.json*
**/*.key
**/*.gpg
**/*.enc
**/__pycache__/
**/*.pyc
**/*.log
**/.cache/
